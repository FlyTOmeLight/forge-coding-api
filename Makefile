.PHONY: test integration vet build image
test:
	GOWORK=off go test ./...
	cd sdk/go/codingv1 && GOWORK=off go test ./...
integration:
	@test -n "$$TEST_DATABASE_URL" || (echo 'TEST_DATABASE_URL required'; exit 1)
	GOWORK=off go test -race -count=1 ./...
	cd sdk/go/codingv1 && GOWORK=off go test -race -count=1 ./...
	GOWORK=off go vet ./...
	cd sdk/go/codingv1 && GOWORK=off go vet ./...
build:
	GOWORK=off go build -o bin/coding ./cmd/server
	GOWORK=off go build -o bin/import-tenant ./cmd/import-tenant
vet:
	GOWORK=off go vet ./...
	cd sdk/go/codingv1 && GOWORK=off go vet ./...

IMAGE ?= forge-coding-api:dev
image:
	docker build -f deploy/docker/Dockerfile --secret id=github_netrc,src=$(GITHUB_NETRC) -t $(IMAGE) .
