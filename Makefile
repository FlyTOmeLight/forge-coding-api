.PHONY: test integration vet build
test:
	go test ./...
integration:
	@test -n "$$TEST_DATABASE_URL" || (echo 'TEST_DATABASE_URL required'; exit 1)
	go test -race -count=1 ./...
	go vet ./...
build:
	go build -o bin/coding ./cmd/coding
	go build -o bin/import-tenant ./cmd/import-tenant
vet:
	go vet ./...
