DATABASE_URL=postgres://postgres:replace-me@forge-coding-postgres:5432/coding?sslmode=disable
PUBLIC_URL=http://127.0.0.1:8483
TENANT_URL=http://forge-tenant
TENANT_TOKEN=replace-with-tenant-service-token
SERVICE_TOKEN=replace-with-coding-service-token
RUNTIME_URL=http://agentic-kit-api
RUNTIME_TOKEN=replace-with-trusted-runtime-token
CODING_PROJECTS_JSON={"17":true}
WORKSPACE_NAMESPACE=forge-tenant-split
SANDBOX_GATEWAY_URL=http://forge-coding
WORKSPACE_JOB_IMAGE=forge-coding-api:dev
GITLAB_URL=http://gitlab.internal
GITLAB_PUBLIC_URL=https://gitlab.example.com
GITLAB_TOKEN=replace-with-server-side-gitlab-token
# Helm sets the projected Secret path. Leave empty for env-only local runs.
GITLAB_TOKEN_FILE=
MODEL_URL=http://host.docker.internal:11434
LISTEN_ADDR=:8080
